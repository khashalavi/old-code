# Copy to .env (same folder) and fill in:
#   cp .env.example .env && chmod 600 .env
# .env is git-ignored. train.sh / eval.sh read HF_TOKEN from the environment
# first, then from old-code/.env, then from Disentangling-Reasoning/.env.
#
# Create a token (type "Read") at https://huggingface.co/settings/tokens.
# Llama models are gated: the same HF account must also have been granted
# access on the model page (e.g. https://huggingface.co/meta-llama/Llama-2-7b-chat-hf).
HF_TOKEN=hf_your_token_here
